# Copy to .env and fill in. .env is gitignored and must never be committed -
# the assignment brief calls this out explicitly, and a leaked connection URI in a
# public repo is the single cheapest way to lose points on an otherwise good submission.
#
#   cp .env.example .env

# ── CognoDB Cloud (system under test) ─────────────────────────────────────────
# From the console after creating the free c0 instance. The password is shown ONCE.
GBF_COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
GBF_COGNODB_USER=cognodb
GBF_COGNODB_PASSWORD=

# ── Neo4j AuraDB Free ─────────────────────────────────────────────────────────
# Do NOT enable this platform until docs/LEGAL.md records how the Acceptable Use
# Policy's benchmark clause was resolved.
GBF_AURA_URI=neo4j+s://<id>.databases.neo4j.io
GBF_AURA_USER=neo4j
GBF_AURA_PASSWORD=

# ── Memgraph Cloud (trial) ────────────────────────────────────────────────────
# Self-signed certificate: platforms.yaml sets tls_insecure, which rewrites the URI
# scheme to bolt+ssc:// (encrypted, certificate unverified) for this platform only.
GBF_MEMGRAPH_CLOUD_URI=bolt+s://<id>.memgraph.cloud:7687
GBF_MEMGRAPH_CLOUD_USER=
GBF_MEMGRAPH_CLOUD_PASSWORD=

# ── FalkorDB Cloud (free) ─────────────────────────────────────────────────────
# Bolt support is documented as experimental and the free-tier page documents RESP.
# Run scripts/probe_platforms.py before assuming this works.
GBF_FALKORDB_URI=bolt://<host>:<port>
GBF_FALKORDB_USER=falkordb
GBF_FALKORDB_PASSWORD=

# ── Self-hosted parity track (track B) ────────────────────────────────────────
# Every one of these must run under an identical cgroup cap. See docker/compose.parity.yml.
GBF_NEO4J_CE_URI=bolt://localhost:7687
GBF_NEO4J_CE_USER=neo4j
GBF_NEO4J_CE_PASSWORD=

GBF_MEMGRAPH_PARITY_URI=bolt://localhost:7688
GBF_MEMGRAPH_PARITY_USER=
GBF_MEMGRAPH_PARITY_PASSWORD=

GBF_ARCADEDB_URI=bolt://localhost:7689
GBF_ARCADEDB_USER=root
GBF_ARCADEDB_PASSWORD=
